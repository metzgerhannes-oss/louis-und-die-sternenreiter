{
  "name": "louis-und-die-sternenreiter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "npm run verify:scenes && vitest run",
    "build": "npm run generate:scenes && npm run typecheck && vite build",
    "verify:scenes": "npm run generate:scenes && node scripts/verify-scene-assets.mjs",
    "generate:scenes": "node scripts/generate-scene-assets-v3.mjs",
    "predev": "npm run generate:scenes"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "sharp": "^0.34.4"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.26"
  }
}
